{
  "name": "react-helmet-pro",
  "version": "2.3.0",
  "description": "A modern head manager for React, inspired by react-helmet with additional features and async support.",
  "homepage": "https://github.com/opencorex-org/react-helmet-pro#readme",
  "bugs": {
    "url": "https://github.com/opencorex-org/react-helmet-pro/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "react-helmet-pro-audit": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react-router": {
      "types": "./dist/react-router/index.d.ts",
      "default": "./dist/react-router/index.js"
    },
    "./remix": {
      "types": "./dist/remix/index.d.ts",
      "default": "./dist/remix/index.js"
    },
    "./astro": {
      "types": "./dist/astro/index.d.ts",
      "default": "./dist/astro/index.js"
    },
    "./vite-ssr": {
      "types": "./dist/vite-ssr/index.d.ts",
      "default": "./dist/vite-ssr/index.js"
    },
    "./express": {
      "types": "./dist/server/express.d.ts",
      "default": "./dist/server/express.js"
    },
    "./fastify": {
      "types": "./dist/server/fastify.d.ts",
      "default": "./dist/server/fastify.js"
    },
    "./hono": {
      "types": "./dist/server/hono.d.ts",
      "default": "./dist/server/hono.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "default": "./dist/adapters/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint/index.d.ts",
      "default": "./dist/eslint/index.js"
    },
    "./inspector": {
      "types": "./dist/inspector/index.d.ts",
      "default": "./dist/inspector/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./testing/vitest": {
      "types": "./dist/testing/vitest.d.ts",
      "default": "./dist/testing/vitest.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "node_modules/.pnpm/node_modules/.bin/vite --config examples/vite.config.examples.ts",
    "typecheck": "pnpm exec tsc --noEmit && pnpm exec tsc --noEmit -p examples/tsconfig.json",
    "test": "pnpm exec vitest run --pool=forks --poolOptions.forks.singleFork=true",
    "test:watch": "vitest --pool=forks --poolOptions.forks.singleFork=true --max-old-space-size=4096",
    "lint": "eslint . --ext .ts,.tsx",
    "package:verify": "pnpm run build && node ./scripts/verify-package.mjs",
    "release:notes": "node ./scripts/generate-release-notes.mjs",
    "api:check": "node scripts/check-api-surface.mjs",
    "api:update": "node scripts/check-api-surface.mjs --update",
    "bundle:check": "node scripts/bundle-size.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "helmet",
    "head",
    "meta",
    "SEO",
    "async",
    "ssr",
    "react-helmet-pro"
  ],
  "author": "LAHIRU UDAYAKUMARA",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=18.18.0",
    "pnpm": ">=10"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.14.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.1.1"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/opencorex-org/react-helmet-pro.git"
  }
}
